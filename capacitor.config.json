{
  "appId": "it.vicina.extra",
  "appName": "Vicina Extra",
  "webDir": "dist",
  "backgroundColor": "#09090B",
  "android": {
    "backgroundColor": "#09090B",
    "adjustMarginsForEdgeToEdge": "disable"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 600,
      "backgroundColor": "#09090B",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#00000000",
      "overlaysWebView": true
    }
  }
}
